COMPOSE_PROJECT_NAME=landlordservice
HTTP_PORT=18080
APP_ENV=dev
APP_DEBUG=1
APP_SECRET=
POSTGRES_PORT=15432
POSTGRES_DB=landlordservice
POSTGRES_USER=landlordservice
POSTGRES_PASSWORD=

ACCESS_TOKEN_TTL=28800
PASSWORD_RESET_TTL=3600
APP_FRONTEND_URL=http://127.0.0.1:18080
MAILER_DSN=null://null
MAIL_FROM=noreply@example.com
USER_INVITATION_TTL=86400

# Notifications: DB is immediate; enable email only after SMTP setup.
NOTIFICATION_CHANNELS=db
NOTIFICATION_EMAIL_ENABLED=0
