#!/usr/bin/env sh
set -eu

cd "$(dirname "$0")/.."

if [ ! -f .env ]; then
    (
        umask 077
        while IFS= read -r line; do
            case "$line" in
                APP_SECRET=) printf 'APP_SECRET=%s\n' "$(openssl rand -hex 32)" ;;
                POSTGRES_PASSWORD=) printf 'POSTGRES_PASSWORD=%s\n' "$(openssl rand -hex 24)" ;;
                *) printf '%s\n' "$line" ;;
            esac
        done < .env.example > .env
    )
fi

docker compose build --pull php
docker compose run --rm --no-deps php composer install --no-interaction
docker compose run --rm --no-deps node npm ci --no-fund
docker compose run --rm --no-deps node npm run build
docker compose up -d --wait database php nginx
docker compose exec -T php php bin/console doctrine:migrations:migrate --no-interaction

docker compose up -d --build --wait notifications
