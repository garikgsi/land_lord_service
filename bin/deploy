#!/usr/bin/env sh
set -eu
umask 077

usage() {
    cat <<'HELP'
Usage: ./bin/deploy [--env-file PATH] [--check]

Run on the Docker server from the prepared project checkout.
--env-file PATH  Production configuration (default: .env.production).
--check          Validate prerequisites and Compose config without deploying.
--help           Show this help.

The deployment builds images, stops web writers, backs up the database and
avatars, migrates the database and starts the application with a health check.
It does not fetch Git revisions, commit, restore backups or delete data.
HELP
}

project_dir=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
env_file="$project_dir/.env.production"
check_only=0

while [ "$#" -gt 0 ]; do
    case "$1" in
        --env-file)
            [ "$#" -ge 2 ] || { usage >&2; exit 2; }
            env_file=$2
            shift 2
            ;;
        --check) check_only=1; shift ;;
        --help|-h) usage; exit 0 ;;
        *) usage >&2; exit 2 ;;
    esac
done

cd "$project_dir"

if [ ! -f "$env_file" ]; then
    printf 'Missing production env file: %s\n' "$env_file" >&2
    printf 'Copy .env.production.example and fill its values first.\n' >&2
    exit 1
fi

compose() {
    docker compose --project-directory "$project_dir" \
        --env-file "$env_file" -f "$project_dir/compose.production.yaml" "$@"
}

docker compose version >/dev/null
docker info >/dev/null
compose config --quiet

if [ "$check_only" -eq 1 ]; then
    printf 'Production configuration is valid. No services were changed.\n'
    exit 0
fi

mkdir -p var/production/backups var/production/avatars
if ! mkdir var/production/deploy.lock 2>/dev/null; then
    printf 'Deployment lock exists: var/production/deploy.lock\n' >&2
    exit 1
fi

web_stopped=0
finished=0
backup_dir=
cleanup() {
    result=$?
    trap - EXIT
    if [ "$finished" -eq 0 ]; then
        printf 'Deployment failed; no automatic database rollback was attempted.\n' >&2
        if [ "$web_stopped" -eq 1 ]; then
            compose stop nginx php >/dev/null 2>&1 || true
            printf 'Web services remain stopped to avoid a code/schema mismatch.\n' >&2
        fi
        if [ -n "$backup_dir" ]; then
            printf 'Backup directory (check for .partial files): %s\n' "$backup_dir" >&2
        fi
    fi
    rmdir var/production/deploy.lock
    exit "$result"
}

trap cleanup EXIT
trap 'exit 130' INT
trap 'exit 143' TERM
trap 'exit 129' HUP

printf 'Building production images...\n'
compose build php nginx
compose up -d --wait --wait-timeout 120 database

backup_dir="var/production/backups/$(date -u +%Y%m%dT%H%M%SZ)-$$"
mkdir "$backup_dir"
printf 'Recording existing container images...\n'
compose ps --all --quiet > "$backup_dir/containers.txt"
while IFS= read -r container_id; do
    docker container inspect --format '{{.Name}} {{.Image}} {{.Config.Image}}' "$container_id"
done < "$backup_dir/containers.txt" > "$backup_dir/images.txt"

web_stopped=1
compose stop nginx php

printf 'Backing up database and avatars...\n'
compose exec -T database sh -c \
    'pg_dump -U "$POSTGRES_USER" -d "$POSTGRES_DB" --format=custom' \
    > "$backup_dir/database.dump.partial"
mv "$backup_dir/database.dump.partial" "$backup_dir/database.dump"
compose run --rm --no-deps -T --user root php \
    tar -C /app/var/avatars -czf - . > "$backup_dir/avatars.tar.gz.partial"
mv "$backup_dir/avatars.tar.gz.partial" "$backup_dir/avatars.tar.gz"

compose run --rm --no-deps -T --user root php \
    sh -c 'chown -R www-data:www-data /app/var/avatars && chmod 700 /app/var/avatars'

printf 'Applying migrations...\n'
compose run --rm --no-deps -T --user www-data php \
    php bin/console doctrine:migrations:migrate --no-interaction --allow-no-migration

compose up -d --no-deps --force-recreate php
compose exec -T --user www-data php php bin/console cache:clear --env=prod --no-debug
compose up -d --no-deps --force-recreate --wait --wait-timeout 120 nginx

finished=1
printf 'Deployment complete. Backup: %s\n' "$backup_dir"
compose ps
