{
  "name": "landlordservice-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=26.13.1 <27"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "typecheck": "vue-tsc --noEmit",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "mobile:sync": "npm run build && cap sync",
    "test": "node --test tests/*.test.mjs",
    "format": "prettier --write src tests public index.html *.ts *.json *.mjs && eslint --fix src tests public/theme.js *.ts *.mjs",
    "format:check": "eslint src tests public/theme.js *.ts *.mjs"
  },
  "dependencies": {
    "@capacitor/core": "~8.6.2",
    "@fullcalendar/vue3": "~7.1.5",
    "@tabler/core": "~1.7.5",
    "@tabler/icons-vue": "~3.52.0",
    "imask": "7.6.1",
    "mitt": "3.0.1",
    "pinia": "4.1.0",
    "tom-select": "~2.7.0",
    "vue": "~3.5.45",
    "vue-router": "~5.5.1"
  },
  "devDependencies": {
    "@capacitor/cli": "~8.6.2",
    "@vitejs/plugin-vue": "~6.0.11",
    "eslint": "10.15.0",
    "eslint-plugin-vue": "10.12.1",
    "prettier": "3.10.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.73.0",
    "vite": "~8.3.8",
    "vue-tsc": "~3.3.14"
  }
}
